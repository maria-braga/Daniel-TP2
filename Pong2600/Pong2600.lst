    924  f77b							; SetHorizPos routine
    925  f77b							; A = X coordinate
    926  f77b							; X = player number (0 or 1)
    927  f77b							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    928  f77b
    929  f77b							; After this subroutine it is necessary to use
    930  f77b							;
    931  f77b							;	sta WSYNC
    932  f77b							;	sta HMOVE
    933  f77b							;
    934  f77b							; to correctly set the parameters
    935  f77b							; Then better to set (after waitin 26 cpu cycles)
    936  f77b							;
    937  f77b							;	sta HMCLR
    938  f77b							;
    939  f77b							; so next sta HMOVE will not impact the position
    940  f77b
    941  f77b							; Everything should be in the same page
    942  f77b							; otherwise the timing is not correct
    943  f77b
    944  f77b							; The entire routine is positioned in memory at the end just to
    945  f77b							; assure that the branch is not moving to a different page
    946  f77b							; Total size of the routine 18 bytes.
    947  f77b
    948  f77b				   SetHorizPos SUBROUTINE
    949  f77b		       38		      sec		; set carry flag
    950  f77c		       85 02		      sta	WSYNC	; start a new line
    951  f77e				   .DivideLoop
    952  f77e		       e9 0f		      sbc	#15	; subtract 15
    953  f780		       b0 fc		      bcs	.DivideLoop	; branch until negative
    954  f782		       49 07		      eor	#7	; calculate fine offset
    955  f784		       0a		      asl
    956  f785		       0a		      asl
    957  f786		       0a		      asl
    958  f787		       0a		      asl
    959  f788		       95 20		      sta	HMP0,x	; set fine offset
    960  f78a		       95 10		      sta	RESP0,x	; fix coarse position
    961  f78c		       60		      rts		; return to caller
    962  f78d
