    769  f430							; Fetches bitmap data for two digits of a
    770  f430							; BCD-encoded number, storing it in addresses
    771  f430							; FontBuf+x to FontBuf+4+x.
    772  f430				   GetBCDBitmap subroutine
    773  f430							; First fetch the bytes for the 1st digit
    774  f430		       48		      pha		; save original BCD number
    775  f431		       29 0f		      and	#$0F	; mask out the least significant digit
    776  f433		       85 80		      sta	Temp
    777  f435		       0a		      asl
    778  f436		       0a		      asl
    779  f437		       65 80		      adc	Temp	; multiply by 5
    780  f439		       a8		      tay		; -> Y
    781  f43a		       a9 05		      lda	#5
    782  f43c		       85 80		      sta	Temp	; count down from 5
    783  f43e				   .loop1
    784  f43e		       b9 06 f7 	      lda	DigitsBitmap,y
    785  f441		       29 0f		      and	#$0F	; mask out leftmost digit
    786  f443		       95 8d		      sta	FontBuf,x	; store leftmost digit
    787  f445		       c8		      iny
    788  f446		       e8		      inx
    789  f447		       c6 80		      dec	Temp
    790  f449		       d0 f3		      bne	.loop1
    791  f44b							; Now do the 2nd digit
    792  f44b		       68		      pla		; restore original BCD number
    793  f44c		       4a		      lsr
    794  f44d		       4a		      lsr
    795  f44e		       4a		      lsr
    796  f44f		       4a		      lsr		; shift right by 4 (in BCD, divide by 10)
    797  f450		       85 80		      sta	Temp
    798  f452		       0a		      asl
    799  f453		       0a		      asl
    800  f454		       65 80		      adc	Temp	; multiply by 5
    801  f456		       a8		      tay		; -> Y
    802  f457		       ca		      dex
    803  f458		       ca		      dex
    804  f459		       ca		      dex
    805  f45a		       ca		      dex
    806  f45b		       ca		      dex		; subtract 5 from X (reset to original)
    807  f45c		       a9 05		      lda	#5
    808  f45e		       85 80		      sta	Temp	; count down from 5
    809  f460				   .loop2
    810  f460		       b9 06 f7 	      lda	DigitsBitmap,y
    811  f463		       29 f0		      and	#$F0	; mask out leftmost digit
    812  f465		       15 8d		      ora	FontBuf,x	; combine left and right digits
    813  f467		       95 8d		      sta	FontBuf,x	; store combined digits
    814  f469		       c8		      iny
    815  f46a		       e8		      inx
    816  f46b		       c6 80		      dec	Temp
    817  f46d		       d0 f1		      bne	.loop2
    818  f46f		       60		      rts
