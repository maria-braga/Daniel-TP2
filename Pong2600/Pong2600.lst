    870  f788							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    871  f788							; SetHorizPos routine
    872  f788							; A = X coordinate
    873  f788							; X = player number (0 or 1)
    874  f788							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    875  f788
    876  f788							; After this subroutine it is necessary to use
    877  f788							;
    878  f788							;	sta WSYNC
    879  f788							;	sta HMOVE
    880  f788							;
    881  f788							; to correctly set the parameters
    882  f788							; Then better to set (after waitin 26 cpu cycles)
    883  f788							;
    884  f788							;	sta HMCLR
    885  f788							;
    886  f788							; so next sta HMOVE will not impact the position
    887  f788
    888  f788							; Everything should be in the same page
    889  f788							; otherwise the timing is not correct
    890  f788
    891  f788							; The entire routine is positioned in memory at the end just to
    892  f788							; assure that the branch is not moving to a different page
    893  f788							; Total size of the routine 18 bytes.
    894  f788
    895  f788				   SetHorizPos SUBROUTINE
    896  f788		       38		      sec		; set carry flag
    897  f789		       85 02		      sta	WSYNC	; start a new line
    898  f78b				   .DivideLoop
    899  f78b		       e9 0f		      sbc	#15	; subtract 15
    900  f78d		       b0 fc		      bcs	.DivideLoop	; branch until negative
    901  f78f		       49 07		      eor	#7	; calculate fine offset
    902  f791		       0a		      asl
    903  f792		       0a		      asl
    904  f793		       0a		      asl
    905  f794		       0a		      asl
    906  f795		       95 20		      sta	HMP0,x	; set fine offset
    907  f797		       95 10		      sta	RESP0,x	; fix coarse position
    908  f799		       60		      rts		; return to caller
    909  f79a
