    823  f757							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    824  f757							; SetHorizPos routine
    825  f757							; A = X coordinate
    826  f757							; X = player number (0 or 1)
    827  f757							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    828  f757
    829  f757							; After this subroutine it is necessary to use
    830  f757							;
    831  f757							;	sta WSYNC
    832  f757							;	sta HMOVE
    833  f757							;
    834  f757							; to correctly set the parameters
    835  f757							; Then better to set (after waitin 26 cpu cycles)
    836  f757							;
    837  f757							;	sta HMCLR
    838  f757							;
    839  f757							; so next sta HMOVE will not impact the position
    840  f757
    841  f757							; Everything should be in the same page
    842  f757							; otherwise the timing is not correct
    843  f757
    844  f757							; The entire routine is positioned in memory at the end just to
    845  f757							; assure that the branch is not moving to a different page
    846  f757							; Total size of the routine 18 bytes.
    847  f757
    848  f757				   SetHorizPos SUBROUTINE
    849  f757		       38		      sec		; set carry flag
    850  f758		       85 02		      sta	WSYNC	; start a new line
    851  f75a				   .DivideLoop
    852  f75a		       e9 0f		      sbc	#15	; subtract 15
    853  f75c		       b0 fc		      bcs	.DivideLoop	; branch until negative
    854  f75e		       49 07		      eor	#7	; calculate fine offset
    855  f760		       0a		      asl
    856  f761		       0a		      asl
    857  f762		       0a		      asl
    858  f763		       0a		      asl
    859  f764		       95 20		      sta	HMP0,x	; set fine offset
    860  f766		       95 10		      sta	RESP0,x	; fix coarse position
    861  f768		       60		      rts		; return to caller
    862  f769
