    864  f769							; Epilogue
    865  f769							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    866  f769
    867  f7fc					      org	$f7fc
    868  f7fc		       00 f0		      .word.w	Start	; reset vectora
    869  f7fe		       00 f0		      .word.w	Start	; BRK vectordaw
