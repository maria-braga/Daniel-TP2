    711  f3c7							; Fetches bitmap data for two digits of a
    712  f3c7							; BCD-encoded number, storing it in addresses
    713  f3c7							; FontBuf+x to FontBuf+4+x.
    714  f3c7				   GetBCDBitmap subroutine
    715  f3c7							; First fetch the bytes for the 1st digit
    716  f3c7		       48		      pha		; save original BCD number
    717  f3c8		       29 0f		      and	#$0F	; mask out the least significant digit
    718  f3ca		       85 80		      sta	Temp
    719  f3cc		       0a		      asl
    720  f3cd		       0a		      asl
    721  f3ce		       65 80		      adc	Temp	; multiply by 5
    722  f3d0		       a8		      tay		; -> Y
    723  f3d1		       a9 05		      lda	#5
    724  f3d3		       85 80		      sta	Temp	; count down from 5
    725  f3d5				   .loop1
    726  f3d5		       b9 04 f7 	      lda	DigitsBitmap,y
    727  f3d8		       29 0f		      and	#$0F	; mask out leftmost digit
    728  f3da		       95 8a		      sta	FontBuf,x	; store leftmost digit
    729  f3dc		       c8		      iny
    730  f3dd		       e8		      inx
    731  f3de		       c6 80		      dec	Temp
    732  f3e0		       d0 f3		      bne	.loop1
    733  f3e2							; Now do the 2nd digit
    734  f3e2		       68		      pla		; restore original BCD number
    735  f3e3		       4a		      lsr
    736  f3e4		       4a		      lsr
    737  f3e5		       4a		      lsr
    738  f3e6		       4a		      lsr		; shift right by 4 (in BCD, divide by 10)
    739  f3e7		       85 80		      sta	Temp
    740  f3e9		       0a		      asl
    741  f3ea		       0a		      asl
    742  f3eb		       65 80		      adc	Temp	; multiply by 5
    743  f3ed		       a8		      tay		; -> Y
    744  f3ee		       ca		      dex
    745  f3ef		       ca		      dex
    746  f3f0		       ca		      dex
    747  f3f1		       ca		      dex
    748  f3f2		       ca		      dex		; subtract 5 from X (reset to original)
    749  f3f3		       a9 05		      lda	#5
    750  f3f5		       85 80		      sta	Temp	; count down from 5
    751  f3f7				   .loop2
    752  f3f7		       b9 04 f7 	      lda	DigitsBitmap,y
    753  f3fa		       29 f0		      and	#$F0	; mask out leftmost digit
    754  f3fc		       15 8a		      ora	FontBuf,x	; combine left and right digits
    755  f3fe		       95 8a		      sta	FontBuf,x	; store combined digits
    756  f400		       c8		      iny
    757  f401		       e8		      inx
    758  f402		       c6 80		      dec	Temp
    759  f404		       d0 f1		      bne	.loop2
    760  f406		       60		      rts
