    706  f3c8							; Fetches bitmap data for two digits of a
    707  f3c8							; BCD-encoded number, storing it in addresses
    708  f3c8							; FontBuf+x to FontBuf+4+x.
    709  f3c8				   GetBCDBitmap subroutine
    710  f3c8							; First fetch the bytes for the 1st digit
    711  f3c8		       48		      pha		; save original BCD number
    712  f3c9		       29 0f		      and	#$0F	; mask out the least significant digit
    713  f3cb		       85 80		      sta	Temp
    714  f3cd		       0a		      asl
    715  f3ce		       0a		      asl
    716  f3cf		       65 80		      adc	Temp	; multiply by 5
    717  f3d1		       a8		      tay		; -> Y
    718  f3d2		       a9 05		      lda	#5
    719  f3d4		       85 80		      sta	Temp	; count down from 5
    720  f3d6				   .loop1
    721  f3d6		       b9 03 f7 	      lda	DigitsBitmap,y
    722  f3d9		       29 0f		      and	#$0F	; mask out leftmost digit
    723  f3db		       95 8c		      sta	FontBuf,x	; store leftmost digit
    724  f3dd		       c8		      iny
    725  f3de		       e8		      inx
    726  f3df		       c6 80		      dec	Temp
    727  f3e1		       d0 f3		      bne	.loop1
    728  f3e3							; Now do the 2nd digit
    729  f3e3		       68		      pla		; restore original BCD number
    730  f3e4		       4a		      lsr
    731  f3e5		       4a		      lsr
    732  f3e6		       4a		      lsr
    733  f3e7		       4a		      lsr		; shift right by 4 (in BCD, divide by 10)
    734  f3e8		       85 80		      sta	Temp
    735  f3ea		       0a		      asl
    736  f3eb		       0a		      asl
    737  f3ec		       65 80		      adc	Temp	; multiply by 5
    738  f3ee		       a8		      tay		; -> Y
    739  f3ef		       ca		      dex
    740  f3f0		       ca		      dex
    741  f3f1		       ca		      dex
    742  f3f2		       ca		      dex
    743  f3f3		       ca		      dex		; subtract 5 from X (reset to original)
    744  f3f4		       a9 05		      lda	#5
    745  f3f6		       85 80		      sta	Temp	; count down from 5
    746  f3f8				   .loop2
    747  f3f8		       b9 03 f7 	      lda	DigitsBitmap,y
    748  f3fb		       29 f0		      and	#$F0	; mask out leftmost digit
    749  f3fd		       15 8c		      ora	FontBuf,x	; combine left and right digits
    750  f3ff		       95 8c		      sta	FontBuf,x	; store combined digits
    751  f401		       c8		      iny
    752  f402		       e8		      inx
    753  f403		       c6 80		      dec	Temp
    754  f405		       d0 f1		      bne	.loop2
    755  f407		       60		      rts
