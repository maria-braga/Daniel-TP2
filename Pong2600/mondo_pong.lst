    625  f34e							; Fetches bitmap data for two digits of a
    626  f34e							; BCD-encoded number, storing it in addresses
    627  f34e							; FontBuf+x to FontBuf+4+x.
    628  f34e				   GetBCDBitmap subroutine
    629  f34e							; First fetch the bytes for the 1st digit
    630  f34e		       48		      pha		; save original BCD number
    631  f34f		       29 0f		      and	#$0F	; mask out the least significant digit
    632  f351		       85 80		      sta	Temp
    633  f353		       0a		      asl
    634  f354		       0a		      asl
    635  f355		       65 80		      adc	Temp	; multiply by 5
    636  f357		       a8		      tay		; -> Y
    637  f358		       a9 05		      lda	#5
    638  f35a		       85 80		      sta	Temp	; count down from 5
    639  f35c				   .loop1
    640  f35c		       b9 00 f7 	      lda	DigitsBitmap,y
    641  f35f		       29 0f		      and	#$0F	; mask out leftmost digit
    642  f361		       95 87		      sta	FontBuf,x	; store leftmost digit
    643  f363		       c8		      iny
    644  f364		       e8		      inx
    645  f365		       c6 80		      dec	Temp
    646  f367		       d0 f3		      bne	.loop1
    647  f369							; Now do the 2nd digit
    648  f369		       68		      pla		; restore original BCD number
    649  f36a		       4a		      lsr
    650  f36b		       4a		      lsr
    651  f36c		       4a		      lsr
    652  f36d		       4a		      lsr		; shift right by 4 (in BCD, divide by 10)
    653  f36e		       85 80		      sta	Temp
    654  f370		       0a		      asl
    655  f371		       0a		      asl
    656  f372		       65 80		      adc	Temp	; multiply by 5
    657  f374		       a8		      tay		; -> Y
    658  f375		       ca		      dex
    659  f376		       ca		      dex
    660  f377		       ca		      dex
    661  f378		       ca		      dex
    662  f379		       ca		      dex		; subtract 5 from X (reset to original)
    663  f37a		       a9 05		      lda	#5
    664  f37c		       85 80		      sta	Temp	; count down from 5
    665  f37e				   .loop2
    666  f37e		       b9 00 f7 	      lda	DigitsBitmap,y
    667  f381		       29 f0		      and	#$F0	; mask out leftmost digit
