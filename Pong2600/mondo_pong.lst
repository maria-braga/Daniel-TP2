    731  f753							; SetHorizPos routine
    732  f753							; A = X coordinate
    733  f753							; X = player number (0 or 1)
    734  f753							;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
    735  f753
    736  f753							; After this subroutine it is necessary to use
    737  f753							;
    738  f753							;	sta WSYNC
    739  f753							;	sta HMOVE
    740  f753							;
    741  f753							; to correctly set the parameters
    742  f753							; Then better to set (after waitin 26 cpu cycles)
    743  f753							;
    744  f753							;	sta HMCLR
    745  f753							;
    746  f753							; so next sta HMOVE will not impact the position
    747  f753
    748  f753							; Everything should be in the same page
    749  f753							; otherwise the timing is not correct
    750  f753
    751  f753							; The entire routine is positioned in memory at the end just to
    752  f753							; assure that the branch is not moving to a different page
    753  f753							; Total size of the routine 18 bytes.
    754  f753
    755  f753				   SetHorizPos SUBROUTINE
    756  f753		       38		      sec		; set carry flag
    757  f754		       85 02		      sta	WSYNC	; start a new line
    758  f756				   .DivideLoop
    759  f756		       e9 0f		      sbc	#15	; subtract 15
    760  f758		       b0 fc		      bcs	.DivideLoop	; branch until negative
    761  f75a		       49 07		      eor	#7	; calculate fine offset
    762  f75c		       0a		      asl
    763  f75d		       0a		      asl
